#!/usr/bin/env bash
# =========================================================================== #
# Description: Portable task manager for the command line.
# Synopsis:    bash todo <command> [<argument>...]

# ERROR HANDLERS ============================================================ #

set -euo pipefail
set -o errtrace

die() {
	local code="${1:-1}"
	local desc="${2:-An unknown error has occurred.}"
	local line_no="${3:+, line $3}"

	printf "ERROR: %s\n" "$desc" >&2
	if [[ "$code" -eq 2 ]]; then
		printf "Try 'bash todo help' for more information.\n" >&2
	else
		printf "--> %s%s\n" "${FUNCNAME[@]:1:-1}" "$line_no" >&2
	fi
	exit "$code"
}

trap 'die 1 "Command failed unexpectedly." "$LINENO"' ERR

# SETTINGS ================================================================== #

readonly APP_ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"

readonly CONFIG_FILE="${APP_ROOT}/todo.conf"
if [[ -f "$CONFIG_FILE" ]]; then source "$CONFIG_FILE"; fi

readonly DATA_DIR="${DATA_DIR:-$APP_ROOT}"
if [[ "$DATA_DIR" != "$APP_ROOT" ]]; then
	mkdir -p "$DATA_DIR" || die 1 "Could not create directory at ${DATA_DIR}."
fi

readonly TODO_FILE="${DATA_DIR}/todo.txt"
if [[ ! -f "$TODO_FILE" ]]; then touch "$TODO_FILE"; fi
[[ -r "$TODO_FILE" ]] || die 1 "Permission denied: Cannot read todo.txt."
[[ -w "$TODO_FILE" ]] || die 1 "Permission denied: Cannot write to todo.txt."

readonly DISABLE_EMOJIS="${DISABLE_EMOJIS:-false}"

# UTILITIES ================================================================= #

MARK_ADD="✨"
MARK_DEL="🗑️"
MARK_DONE="✅"
MARK_UNDO="↩️"

if [[ "$DISABLE_EMOJIS" == "true" ]]; then
	MARK_ADD="[+]"
	MARK_DEL="[-]"
	MARK_DONE="[x]"
	MARK_UNDO="[ ]"
fi

TODO_LINE_COUNT="$(wc -l < "$TODO_FILE")"
INDEX_WIDTH="${#TODO_LINE_COUNT}"

is_index_valid() {
	if [[ ! "$1" =~ ^[0-9]+$ || $1 -eq 0 || $1 -gt "$TODO_LINE_COUNT" ]]; then
		printf "%s is not a valid number.\n"; return 1
	fi
}

# SUBCOMMANDS =============================================================== #

todo_help() {
	cat <<-EOF
	USAGE
	  bash todo <command> [<argument>...]

	COMMANDS
	  add   <description>
	  del   <index>...
	  done  <index>...
	  undo  <index>...
	EOF
	exit 0
}

todo_add() {
	[[ $# -gt 0 ]] || die 2 "Task description cannot be empty."
	local task; task="$(awk '$1=$1' <<< "$*")"
	local index; index="$(( ${TODO_LINE_COUNT} + 1 ))"
	printf "%s\n" "$task" >> "$TODO_FILE"
	printf "%s %-*d %s\n" "$MARK_ADD" "$INDEX_WIDTH" "$index" "$task"
}

todo_del() {
	[[ $# -gt 0 ]] || die 2 "Task index required."
	local task formatted_task valid_tasks="" sed_args=()

	local i; for i in "$@"; do
		if ! is_index_valid "$i"; then continue; fi
		task="$(sed -n "${index}p" "$TODO_FILE")"
		printf -v formatted_task "%s %-*d %s\n" "$MARK_DEL" "$INDEX_WIDTH" "$i" "$task"
		sed_args+=("-e" "${i}d")
		valid_tasks+="$formatted_task"
	done

	if [[ "${#sed_args[@]}" -gt 0 ]]; then
		sed -i "${sed_args[@]}" "$TODO_FILE"
		printf "%s" "$valid_tasks"
	fi
}

todo_done() {
	[[ $# -gt 0 ]] || die 2 "Task index required."
	local task formatted_task valid_tasks="" sed_args=()

	local i; for i in "$@"; do
		if ! is_index_valid "$i"; then continue; fi
		task="$(sed -n "${i}p" "$TODO_FILE")"

		if [[ "$task" =~ ^x ]]; then
			printf "Task %d is already marked as done.\n" "$i"; continue
		fi

		printf -v formatted_task "%s %-*d %s\n" "$MARK_DONE" "$INDEX_WIDTH" "$i" "$task"
		sed_args+=("-e" "${i}s/^/x /")
		valid_tasks+="$formatted_task"
	done

	if [[ "${#sed_args[@]}" -gt 0 ]]; then
		sed -i "${sed_args[@]}" "$TODO_FILE"
		printf "%s" "$valid_tasks"
	fi
}

todo_undo() {
	[[ $# -gt 0 ]] || die 2 "Task index required."
	local task formatted_task valid_tasks="" sed_args=()

	local i; for i in "$@"; do
		if ! is_index_valid "$i"; then continue; fi
		task="$(sed -n "${i}p" "$TODO_FILE")"

		if [[ ! "$task" =~ ^x ]]; then
			printf "Task %d is already unchecked.\n" "$i"; continue
		fi

		printf -v formatted_task "%s %-*d %s\n" "$MARK_UNDO" "$INDEX_WIDTH" "$i" "$task"
		sed_args+=("-e" "${i}s/^x //")
		valid_tasks+="$formatted_task"
	done

	if [[ "${#sed_args[@]}" -gt 0 ]]; then
		sed -i "${sed_args[@]}" "$TODO_FILE"
		printf "%s" "$valid_tasks"
	fi
}

# MAIN ====================================================================== #

main() {
	if [[ $# -eq 0 ]]; then todo_help; fi
	local cmd="${1:-}"; shift
	case "$cmd" in
		add)  todo_add  "$@" ;;
		del)  todo_del  "$@" ;;
		done) todo_done "$@" ;;
		undo) todo_undo "$@" ;;
		help) todo_help "$@" ;;
		*)    die 2 "${cmd} is not a valid command." ;;
	esac
}

if [[ "${BASH_SOURCE[0]}" == "${0}" ]]; then
	main "$@"
fi
