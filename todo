#!/usr/bin/env bash
# =========================================================================== #
# [todo] command line task manager
# =========================================================================== #

set -euo pipefail
set -o errtrace

readonly DATA_DIR="${XDG_DATA_HOME:-$HOME/.local/share}/todo-cli"
readonly TODO_FILE="${DATA_DIR}/todo.txt"
readonly DONE_FILE="${DATA_DIR}/done.txt"

# Arguments:
# $1	INT - Line number
# $2	STR - Error description (optional)
# $3	STR - Subcommand usage (optional)
die() {
	local lineno="${1:-?}" desc="${2:-unknown error}" usage="${3:-}"
	printf "[ERROR] %s\n" "$desc" >&2
	printf "--> %s, line %d\n" "${FUNCNAME[@]:1:-1}" "$lineno" >&2
	if [[ -n "$usage" ]]; then printf "[USAGE] %s\n" "$usage" >&2; fi
	exit 1
}

trap 'die "$LINENO" "failed command (trap)"' ERR

# Helper functions ========================================================== #

# Arguments:
# $1	INT - Task index
# $2	STR - Source file path: "$TODO_FILE", "$DONE_FILE"
validate_task_index() {
	local index="${1:-}" src="${2:-}"
	[[ -n "$index" ]] || die "$LINENO" "arg missing: 1) line number"
	[[ -n "$src" ]]   || die "$LINENO" "arg missing: 2) source file path"
	[[ -f "$src" ]]   || die "$LINENO" "'${src##*/}' was not found in ${DATA_DIR}"

	local line_count; line_count="$(wc -l < "$src")"
	if [[ ! "$index" =~ ^[0-9]+$ ]]; then
		die "$LINENO" "line number '${index}' is not an integer"
	elif [[ $index -gt $line_count ]]; then
		die "$LINENO" "line '${index}' was not found in ${src##*/}"
	elif [[ $index -eq 0 ]]; then
		die "$LINENO" "line number can't be 0"
	else return 0; fi
}

# Arguments:
# $1	STR - String to append
# $2	STR - Target path: "$TODO_FILE", "$DONE_FILE"
# $3	INT - Index number from source file (optional)
insert_task() {
	local input_line="${1:-}" dest="${2:-}" src_index="${3:-}"
	[[ -n "$input_line" ]] || die "$LINENO" "arg missing: 1) task string"
	[[ -n "$dest" ]]       || die "$LINENO" "arg missing: 2) dest file path"
	[[ -f "$dest" ]]       || die "$LINENO" "'${dest##*/}' was not found in ${DATA_DIR}"

	local todo_cmd="${FUNCNAME[-2]}" task_name="task"
	if [[ -n "$src_index" ]]; then task_name+=" ${src_index}"; fi
	local clean_line; clean_line="$(awk '$1=$1' <<< "$input_line")"
	local output_line="" current_date=""

	if [[ "$todo_cmd" == "todo_add" || "$todo_cmd" == "todo_done" ]]
		current_date="$(date +%F)";
		output_line="${current_date} ${clean_line}"
	elif [[ "$todo_cmd" == "todo_undo" ]]; then
		output_line="${clean_line#[0-9][0-9][0-9][0-9]-[0-9][0-9]-[0-9][0-9] }"
	else
		die "$LINENO" "'${todo_cmd}' is not a valid command function"
	fi

	printf "%s\n" "$output_line" >> "$dest"
	if ! grep -qF "$output_line" "$dest"; then
		die "$LINENO" "failed to insert ${task_name} into ${dest##*/}"
	fi
}

# Arguments:
# $1	STR - Source filename: "todo.txt", "done.txt"
# $2	STR - Target filename: "todo.txt", "done.txt" (optional)
# ...	INT - Task index
move_tasks() {
	local src_name="${1:-}" src="${DATA_DIR}/${src_name}" arg_min="2"; shift
	[[ -n "$src" ]] || die "$LINENO" "arg missing: 1) source filename"
	[[ -f "$src" ]] || die "$LINENO" "'${src_name}' was not found in ${DATA_DIR}"

	local dest_name="" dest=""
	if [[ "${1:-}" =~ \.txt$ ]]; then
		dest_name="$1"; dest="${DATA_DIR}/${dest_name}"; arg_min="3"; shift
		if [[ "$src" == "$dest" ]]; then
			die "$LINENO" "'${dest_name}' can't be both source and dest file"
		fi
	fi

	[[ $# -eq 0 ]] && die "arg missing: ${arg_min}) task index"
	local line index; for index in "$@"; do
		validate_task_index "$index" "$src"
		line="$(sed -n "${index}p" "$src")"

		if [[ -n "$dest" ]]; then
			insert_task "$line" "$dest" "$index"
		fi

		sed -i "${index}d" "$src"
		if grep -qF "$line" "$src"; then
			die "$LINENO" "failed to remove task ${index} from ${src_name}"
		fi
	done
}

# Main execution ============================================================ #

todo_help() {
	cat <<-EOF
	USAGE
	bash todo <command> [<argument>...]

	COMMANDS
	add   <task>
	del   [todo|done] <index>...
	done  <index>...
	undo  <index>...
	EOF
	exit 0
}

todo_add() {
	local usage="bash todo add <task>"
	[[ $# -gt 0 ]] || die "$LINENO" "missing arguments" "$usage"

	local task_input="$*"
	insert_task "$task_input" "$TODO_FILE"
}

todo_del() {
	local usage="bash todo del [todo|done] <index>..."
	[[ $# -gt 0 ]] || die "$LINENO" "missing arguments" "$usage"

	local src_name="todo.txt"
	if [[ "$1" == "done" || "$1" == "todo" ]]; then
		src_name="${1}.txt"; shift
	fi

	move_tasks "$src_name" "$@"
}

todo_done() {
	local usage="bash todo done <index>..."
	[[ $# -gt 0 ]] || die "$LINENO" "missing arguments" "$usage"
	move_tasks "todo.txt" "done.txt" "$@"
}

todo_undo() {
	local usage="bash todo undo <index>..."
	[[ $# -gt 0 ]] || die "$LINENO" "missing arguments" "$usage"
	move_tasks "done.txt" "todo.txt" "$@"
}

main() {
	local cmd="${1:-}"; shift
	local usage="bash todo <command> [<argument>...]"
	[[ $# -gt 0 ]] || die "$LINENO" "missing command" "$usage"

	mkdir -p "$DATA_DIR"
	touch "$TODO_FILE" "$DONE_FILE"

	case "$cmd" in
		add)  todo_add "$@" ;;
		del)  todo_del "$@" ;;
		done) todo_done "$@" ;;
		undo) todo_undo "$@" ;;
		help) todo_help "$@" ;;
		*)    die "$LINENO" "${cmd} is not a valid command" ;;
	esac
}

if [[ "${BASH_SOURCE[0]}" == "${0}" ]]; then
	main "$@"
fi
