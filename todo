#!/usr/bin/env bash
# =========================================================================== #
# Description:	Task manager for the command line
# Command:			bash todo
# =========================================================================== #
set -euo pipefail
set -o errtrace

readonly DATA_DIR="${XDG_DATA_HOME:-$HOME/.local/share}/todo-cli"
readonly TODO_FILE="${DATA_DIR}/todo.txt"
readonly DONE_FILE="${DATA_DIR}/done.txt"

# Arguments:
# $1	INT - Line number
# $2	STR - Error description (optional)
die() {
	local line_num="${1:-?}" desc="${2:-unknown error}"
	local func_stack=("${FUNCNAME[@]:1:-1}")
	printf "[ERROR] %s\n" "$desc" >&2
	printf "--> %s, line %d\n" "${func_stack[@]}" "$line_num" >&2
	exit 1
}

trap 'die "$LINENO" "failed command (trap)"' ERR

# =========================================================================== #
# Helper functions
# =========================================================================== #

# Arguments:
# $1	STR - Source file path: "$TODO_FILE", "$DONE_FILE"
# $2	INT - Line number
assert_task_exists() {
	local src="${1:-}" num="${2:-}"
	if [[ -z "$src" ]]; then die "$LINENO" "arg missing: 1) source file path"; fi
	if [[ -z "$num" ]]; then die "$LINENO" "arg missing: 2) line number"; fi
	if [[ ! -f "$src" ]]; then
		die "$LINENO" "'${src##*/}' was not found in ${DATA_DIR}"
	fi

	local line_count; line_count="$(wc -l < "$src")"
	if [[ ! "$num" =~ ^[0-9]+$ ]]; then
		die "$LINENO" "line number '${num}' is not an integer"
	elif [[ $num -gt $line_count ]]; then
		die "$LINENO" "line '${num}' was not found in ${src##*/}"
	elif [[ $num -eq 0 ]]; then
		die "$LINENO" "line number can't be 0"
	else return 0; fi
}

# Arguments:
# $1	STR - Line to append
# $2	STR - Target path: "$TODO_FILE", "$DONE_FILE"
# $3	INT - Former line number (optional)
insert_task() {
	local task="${1:-}" dest="${2:-}" num="${3:-}"
	if [[ -z "$task" ]]; then die "$LINENO" "arg missing: 1) task string"; fi
	if [[ -z "$dest" ]]; then die "$LINENO" "arg missing: 2) dest file path"; fi
	if [[ ! -f "$dest" ]]; then
		die "$LINENO" "'${dest##*/}' was not found in ${DATA_DIR}"
	fi

	local subcmd="${FUNCNAME[-2]}"
	local formatted_task current_date

	if [[ "$subcmd" == "todo_add" || "$subcmd" == "todo_done" ]]
		current_date="$(date +%F)";
		formatted_task="${current_date} ${task}"
	elif [[ "$subcmd" == "todo_undo" ]]; then
		formatted_task="${task#[0-9][0-9][0-9][0-9]-[0-9][0-9]-[0-9][0-9] }"
	else
		die "$LINENO" "'${subcmd}' is not a valid subcommand function"
	fi

	printf "%s\n" "$formatted_task" >> "$dest"
	if ! grep -qF "$formatted_task" "$dest"; then
		die "$LINENO" "failed to insert task${num:+" $num"} into ${dest##*/}"
	fi
}

# Arguments:
# $1	STR - Source filename: "todo.txt", "done.txt"
# $2	STR - Target filename: "todo.txt", "done.txt" (optional)
# ...	INT - Line numbers
move_lines() {
	local src_name="${1:-}" src="${DATA_DIR}/${src_name}" arg_min="2"; shift
	if [[ -z "$src" ]]; then die "$LINENO" "arg missing: 1) source filename"; fi
	if [[ ! -f "$src" ]];	then
		die "$LINENO" "'${src_name}' was not found in ${DATA_DIR}"
	fi

	local dest_name="" dest=""
	if [[ "${1:-}" =~ \.txt$ ]]; then
		dest_name="$1"; dest="${DATA_DIR}/${dest_name}"; arg_min="3"; shift
		if [[ "$src" == "$dest" ]];	then
			die "$LINENO" "'${dest_name}' can't both be source and dest file"
		fi
	fi

	if [[ $# -eq 0 ]]; then die "arg missing: ${arg_min}) line number"; fi

	local line num; for num in "$@"; do
		assert_task_exists "$src" "$num"
		line="$(sed -n "${num}p" "$srch")"

		if [[ -n "$dest" ]]; then
			insert_line "$line" "$dest" "$num"
		fi

		sed -i "${num}d" "$src"
		if grep -qF "$line" "$src"; then
			die "$LINENO" "failed to remove task ${num} from ${src_name}"
		fi
	done
}

# =========================================================================== #
# Main execution
# =========================================================================== #

# Synopsis: bash todo.sh help
todo_help() {
	cat <<- EOF
	USAGE
	bash todo <command> [<argument>...]

	COMMANDS
	add   <task>
	del   <file-stem> <line-number>...
	done  <line-number>...
	undo  <line-number>...
	EOF
	exit 0
}

# Command: bash todo.sh add <task>
todo_add() {
	if [[ $# -eq 0 ]]; then die "$LINENO" "missing arguments"; fi
	local task_desc; task_desc="$(awk '$1=$1' <<< "$*")"
	insert_line "$task_desc" "$TODO_FILE"
}

# Command: bash todo.sh del <file-stem> <line-number>...
todo_del() {
	if [[ $# -lt 2 ]]; then die "$LINENO" "missing arguments"; fi
	local src_name="${1}.txt"; shift
	move_lines "$src_name" "$@"
}

# Command: bash todo.sh done <line-number>...
todo_done() {
	if [[ $# -eq 0 ]]; then die "$LINENO" "missing arguments"; fi
	move_lines "todo.txt" "done.txt" "$@"
}

# Command: bash todo.sh undo <line-number>...
todo_undo() {
	if [[ $# -eq 0 ]]; then die "$LINENO" "missing arguments"; fi
	move_lines "done.txt" "todo.txt" "$@"
}

main() {
	if [[ $# -eq 0 ]]; then todo_help; fi

	mkdir -p "$DATA_DIR"
	touch "$TODO_FILE" "$DONE_FILE"

	local cmd="$1"; shift
	case "$cmd" in
		add)	todo_add	"$@" ;;
		del)	todo_del	"$@" ;;
		done)	todo_done	"$@" ;;
		undo)	todo_undo	"$@" ;;
		help)	todo_help	"$@" ;;
		*)		die "$LINENO" "${cmd} is not a valid command" ;;
	esac
}

main "$@"
