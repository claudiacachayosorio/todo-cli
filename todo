#!/usr/bin/env bash
# =========================================================================== #
# [todo] command line task manager
# =========================================================================== #
set -euo pipefail
set -o errtrace

# Arguments:
#  $1 INT Exit code: 1, 2
#  $2 INT Line number
#  $3 STR Error description
die() {
	local code="${1:-1}" lineno="${2:-?}"
	local desc="${3:-An unknown error has occurred.}"
	local usage="${USAGE_SNIPPETS[${FUNCNAME[-2]}]}"

	printf "[ERROR] %s\n" "$desc" >&2
	if [[ "$code" -eq 2 ]]; then
		printf "Usage: bash todo %s\n" "${usage:-${USAGE_SNIPPETS[todo]}}" >&2
		printf "Try 'bash todo help' for more information.\n" >&2
	else
		lineno="${3:-?}"
		printf "Function: %s\n" "${FUNCNAME[@]:1:-1}" >&2
		printf "Line number: %d\n" "$lineno" >&2
	fi
	exit "$code"
}

trap 'die 1 "$LINENO" "Command failed unexpectedly."' ERR

readonly APP_ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
readonly CONFIG_FILE="${APP_ROOT}/todo.conf"
if [[ -f "$CONFIG_FILE" ]]; then source "$CONFIG_FILE"; fi

readonly DATA_DIR="${DATA_DIR:-$APP_ROOT}"
readonly ARCHIVE="${DATA_DIR}/archive"
mkdir -p "$ARCHIVE"

readonly TODO_FILE="${DATA_DIR}/todo.txt"
readonly DONE_FILE="${ARCHIVE}/done.txt"
touch "$TODO_FILE" "$DONE_FILE"

# USAGE ===================================================================== #

readonly -A USAGE_SNIPPETS=(
	["todo"]="<command> [<argument>...]"
	["todo_add"]="add <description>"
	["todo_del"]="del [--done] <index>..."
	["todo_done"]="done <index>..."
	["todo_undo"]="undo <index>..."
)

usage() {
	cat <<-EOF
	USAGE
	  bash todo <command> [<argument>...]

	COMMANDS
	  add   <description>
	  del   [--done] <index>...
	  done  <index>...
	  undo  <index>...
	EOF
}

# HELPERS =================================================================== #

# Arguments:
#  $1 STR Task string to append
#  $2 STR Target path: "$TODO_FILE", "$DONE_FILE"
#  $3 INT Index number from source file (optional)
insert_task() {
	local input_line="${1:-}" dest="${2:-}" src_index="${3:-}"
	[[ -n "$input_line" ]] || die 1 "$LINENO" "Missing argument: \$1 Task string."
	[[ -n "$dest" ]]       || die 1 "$LINENO" "Missing argument: \$2 Target path."
	[[ -w "$dest" ]]       || die 1 "$LINENO" "Target file ${dest##*/} was not found in ${DATA_DIR}"

	local cmd="${FUNCNAME[-2]#todo_}"
	local task_name="task${src_index:+ $src_index}"
	local clean_line; clean_line="$(awk '$1=$1' <<< "$input_line")"
	local output_line current_date

	case "$cmd" in
		add|done)
			current_date="$(date +%F)"
			output_line="${current_date} ${clean_line}"
			;;
		undo)
			output_line="${clean_line#[0-9][0-9][0-9][0-9]-[0-9][0-9]-[0-9][0-9] }"
			;;
		*) die 1 "$LINENO" "${todo_cmd} is not a valid command function." ;;
	esac

	printf "%s\n" "$output_line" >> "$dest"
	if ! grep -qF "$output_line" "$dest"; then
		die 1 "$LINENO" "Failed to insert ${task_name} into ${dest##*/}"
	fi
}

# Arguments:
#  $1 STR Source filename: "todo.txt", "done.txt"
#  $2 STR Target filename: "todo.txt", "done.txt" (optional)
# ... INT Task indexes
move_tasks() {
	local src_name="${1:-}"; shift
	local src="${DATA_DIR}/${src_name}"
	[[ -n "$src_name" ]] || die 1 "$LINENO" "Missing argument: \$1 Source filename."

	local dest_name="" dest
	if [[ "${1:-}" =~ \.txt$ ]]; then
		dest_name="$1"; shift
		dest="${dest_name:+${DATA_DIR}/${dest_name}}"
	fi

	[[ $# -gt 0 ]] || die 1 "$LINENO" "Missing argument: Task indexes."
	local line_count; line_count="$(wc -l < "$src")"

	# TODO: sort tasks / make sure the index stays correct as lines get removed

	local line index; for index in "$@"; do
		[[ "$index" =~ ^[0-9]+$ ]] || die 2 "$LINENO" "${index} is not an integer."
		(( index != 0 ))           || die 2 "$LINENO" "Task index can't be zero."
		(( index <= line_count ))  || die 2 "$LINENO" "Task ${index} was not found in ${src_name}"

		line="$(sed -n "${index}p" "$src")"
		if [[ -n "$dest" ]]; then
			insert_task "$line" "$dest" "$index"
		fi

		sed -i "${index}d" "$src"
		if grep -qF "$line" "$src"; then
			die 1 "$LINENO" "Failed to remove task ${index} from ${src_name}"
		fi
	done
}

# MAIN EXECUTION ============================================================ #

todo_help() {
	usage; exit 0
}

todo_add() {
	[[ $# -gt 0 ]] || die 2 "$LINENO" "Task description cannot be empty."
	insert_task "$*" "$TODO_FILE"
}

todo_del() {
	local src_name="todo.txt"
	if [[ "${1:-}" == "--done" ]]; then src_name="done.txt"; shift; fi
	[[ $# -gt 0 ]] || die 2 "$LINENO" "Task index required."
	move_tasks "$src_name" "$@"
}

todo_done() {
	[[ $# -gt 0 ]] || die 2 "$LINENO" "Task index required."
	move_tasks "todo.txt" "done.txt" "$@"
}

todo_undo() {
	[[ $# -gt 0 ]] || die 2 "$LINENO" "Task index required."
	move_tasks "done.txt" "todo.txt" "$@"
}

main() {
	if [[ $# -eq 0 ]]; then todo_help; fi
	local cmd="${1:-}"; shift
	case "$cmd" in
		add)  todo_add  "$@" ;;
		del)  todo_del  "$@" ;;
		done) todo_done "$@" ;;
		undo) todo_undo "$@" ;;
		help) todo_help "$@" ;;
		*)    die 2 "$LINENO" "'${cmd}' is not a valid command." ;;
	esac
}

if [[ "${BASH_SOURCE[0]}" == "${0}" ]]; then
	main "$@"
fi
